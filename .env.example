# Google Gemini API Key for Cognitive Reasoning
GEMINI_API_KEY=place_your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Mathematical Incongruence Threshold (0.0 to 1.0)
JSD_THRESHOLD=0.40
JSD_PAIRWISE_THRESHOLD=0.65

# Model Configurations
WHISPER_MODEL_SIZE=base.en
TEXT_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
AUDIO_EMOTION_MODEL=amnesiackid/distilhubert-finetuned-ravdess
