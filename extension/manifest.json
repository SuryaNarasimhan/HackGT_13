{
  "manifest_version": 3,
  "name": "MSAS Call Connection",
  "version": "0.1.0",
  "description": "Share your chosen call tab locally with the MSAS desktop companion.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Connect this call to MSAS" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:47831" }
}
